
// Indicates the status of a class
enum ClassStatus {
  Vista
  Programada
  Cancelada

  @@map("class_status")
}

model Class {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduled_date DateTime     @db.Date
  scheduled_hour String
  status         ClassStatus  @default(Programada)
  raw_response   Json?
  create_at      DateTime     @default(now()) @db.Timestamptz(6)
  update_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("classes")
}
